<?xml version="1.0" encoding="UTF-8"?>
<!-- Trimmed example of `nmap -sV -oX` output against a lab VM (Metasploitable 2 style). -->
<nmaprun scanner="nmap" args="nmap -sV -oX sample_scan.xml 192.168.56.101" version="7.95">
  <host>
    <status state="up"/>
    <address addr="192.168.56.101" addrtype="ipv4"/>
    <ports>
      <port protocol="tcp" portid="21">
        <state state="open"/>
        <service name="ftp" product="vsftpd" version="2.3.4" method="probed">
          <cpe>cpe:/a:vsftpd:vsftpd:2.3.4</cpe>
        </service>
      </port>
      <port protocol="tcp" portid="22">
        <state state="open"/>
        <service name="ssh" product="OpenSSH" version="4.7p1 Debian 8ubuntu1" extrainfo="protocol 2.0" method="probed">
          <cpe>cpe:/a:openbsd:openssh:4.7p1</cpe>
          <cpe>cpe:/o:linux:linux_kernel</cpe>
        </service>
      </port>
      <port protocol="tcp" portid="23">
        <state state="open"/>
        <service name="telnet" product="Linux telnetd" method="probed">
          <cpe>cpe:/o:linux:linux_kernel</cpe>
        </service>
      </port>
      <port protocol="tcp" portid="8080">
        <state state="closed"/>
        <service name="http-proxy" method="table"/>
      </port>
    </ports>
  </host>
</nmaprun>
